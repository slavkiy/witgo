package examples:contract@1.0.0;

// The plugin implements this interface and exposes its metadata to the server.
interface plugin-info {
    use types.{plugin-metadata};

    metadata: func() -> plugin-metadata;
}

// Capabilities supplied explicitly by the Go host.
interface host {
    process-string: func(value: string) -> string;
}

world plugin {
    import host;
    export plugin-info;
}
